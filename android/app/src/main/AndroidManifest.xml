<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature
          android:name="android.hardware.nfc"
          android:required="true"/>
  <uses-permission android:name="android.permission.NFC" />
  <!-- Required at runtime on API 33+ (this app targets 33+) for any
       notification, including FCM, to be shown. flutter_and_friends must
       request this permission (e.g. via a push_notifications cubit) before
       the first announcement arrives, or FCM messages will be silently
       dropped from the notification tray with no error. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="Flutter &amp; Friends" android:name="${applicationName}" android:icon="@mipmap/ic_launcher">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchTheme" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
      <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
      <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
    <meta-data android:name="flutterEmbedding" android:value="2"/>

    <!-- Announcement-only push: all installs subscribe to a single FCM
         topic, so no default
         "click_action" / deep-link routing is configured here. If a
         notification-tap destination is ever wanted, revisit this. -->

    <!-- Default notification channel used by the FCM Android SDK when a
         received message doesn't specify one. Required so Android 8+ shows
         the notification with a sensible name instead of falling back to
         "Miscellaneous". Keep this id in sync with any channel created via
         flutter_local_notifications on the Dart side. -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="announcements"/>
    <!-- Default small icon for FCM notifications. Must be a plain white
         silhouette per Android's status-bar icon rules; falls back to the
         app's launcher icon (which is NOT silhouette-safe) if this drawable
         doesn't exist yet. Add a real ic_stat_announcement asset before
         relying on this. -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_announcement"/>

    <!--
      FCM wiring still required before this manifest is functional (tracked
      in the credentials checklist reported alongside this diff):
        1. Add google-services.json (from the Firebase Android app
           registration) to android/app/.
        2. Apply the com.google.gms.google-services plugin — declared but
           left inert (apply false) in settings.gradle.kts, and stubbed
           as a commented-out block in app/build.gradle.kts — until the
           json above exists, since the plugin fails the build hard when
           it's missing.
        3. No custom FirebaseMessagingService is declared here: this app
           only needs topic-based *display* notifications (notification
           payload, not data-only), which the stock FCM SDK handles
           automatically as long as the app isn't in the foreground. No
           android:name service override is needed for that path.
    -->
  </application>
  <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.PROCESS_TEXT"/>
      <data android:mimeType="text/plain"/>
    </intent>
  </queries>
  <uses-permission android:name="android.permission.INTERNET"/>
</manifest>